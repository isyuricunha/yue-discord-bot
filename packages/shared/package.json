{
  "name": "@yuebot/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/esm/env.js",
      "require": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./template_placeholders": {
      "types": "./dist/template_placeholders.d.ts",
      "import": "./dist/esm/template_placeholders.js",
      "require": "./dist/template_placeholders.js",
      "default": "./dist/template_placeholders.js"
    },
    "./internal-api-contract": {
      "types": "./dist/internal_api_contract.d.ts",
      "import": "./dist/esm/internal_api_contract.js",
      "require": "./dist/internal_api_contract.js",
      "default": "./dist/internal_api_contract.js"
    }
  },
  "scripts": {
    "dev": "tsc -b -w",
    "build": "tsc -b --force && tsc -b tsconfig.esm.json --force",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "pnpm build && node --test dist"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  }
}
